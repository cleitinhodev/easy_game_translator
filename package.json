{
  "name": "easy-game-translator",
  "productName": "Easy Game Translator",
  "version": "4.0.5",
  "description": "Easy Game Translator v4 — tradutor de tela para jogos (Electron + Python)",
  "author": "CleitinhoDEV",
  "license": "GPL-3.0-or-later",
  "repository": { "type": "git", "url": "https://github.com/cleitinhodev/easy_game_translator.git" },
  "homepage": "https://www.bugzinho.com/easygametranslator",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "setup:python": "node scripts/setup-python.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "dist:dir": "npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "test:backend": "node scripts/test-backend.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:links": "node scripts/check-links.mjs",
    "e2e:shots": "bash scripts/e2e/run.sh",
    "test": "npm run check:i18n && npm run check:links && npm run typecheck && npm run test:backend"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "motion": "^14.3.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  }
}
